# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).

# --- ElevenLabs (Speech to Text: Scribe v2, batch) ---
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# --- Extraction LLM (default provider: anthropic) ---
# The extraction step is abstracted behind a small interface (klar/extract.py).
# Swap providers by changing KLAR_LLM_PROVIDER and the matching key.
KLAR_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here
KLAR_LLM_MODEL=claude-sonnet-4-6
# Max output tokens for the brief. Raise for very information-dense calls.
KLAR_LLM_MAX_TOKENS=4096
# Set to 1 only if you deliberately point KLAR_LLM_MODEL at a model Klar doesn't
# recognise yet; otherwise an unknown id fails fast before any paid API call.
KLAR_ALLOW_UNKNOWN_MODEL=0

# --- Speech to Text model / behaviour (overridable per customer config) ---
KLAR_STT_MODEL=scribe_v2

# --- Text to Speech (only used by `klar run --speak`) ---
# Voice for the spoken summary. Leave blank to auto-pick a voice on your account.
KLAR_TTS_VOICE_ID=

# --- Reliability ---
# Transcripts longer than this (chars) are split + map-reduced instead of
# overflowing the model context in a single pass.
KLAR_MAX_TRANSCRIPT_CHARS=24000
# Per-request timeout (seconds) and total attempts (original + retries) applied
# to both the ElevenLabs and Anthropic calls; transient 429/5xx are retried.
KLAR_REQUEST_TIMEOUT_S=120
KLAR_MAX_ATTEMPTS=3

# --- Storage ---
# Where SQLite + transcript/brief artifacts live. Defaults to ./.klar
KLAR_HOME=.klar

# Cost-estimate rates (STT $/hour, LLM $/Mtok) live as defaults in
# klar/pipeline.py (CostRates); override them there if your plan differs.
